# Managed PostgreSQL. Use the provider's pooled URL for Vercel/API runtime.
DATABASE_URL=
# Optional direct URL used only by schema migration tooling.
DATABASE_DIRECT_URL=
DATABASE_POOL_SIZE=3
DATABASE_CONNECTION_TIMEOUT=5000
DATABASE_QUERY_TIMEOUT=30000
DATABASE_IDLE_TIMEOUT=5000

# Existing Supabase identity provider only. No service-role database key is used.
SUPABASE_AUTH_URL=https://your-project-ref.supabase.co
SUPABASE_AUTH_ANON_KEY=your-supabase-publishable-or-anon-key
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# REQUIRED: the single authorized administrator's Supabase user UUID. Every protected
# API handler (api/_utils.js requireAuth) returns 503 ADMIN_ID_NOT_CONFIGURED without it.
ADMIN_SUPABASE_USER_ID=00000000-0000-4000-8000-000000000000

# Optional: comma-separated browser origins allowed to call the API cross-origin
# (e.g. https://app.example.com). The app itself uses same-origin /api URLs, so this
# is normally empty. Wildcards are ignored. Localhost is allowed only outside production.
CORS_ALLOWED_ORIGINS=

# Python worker uses the managed PostgreSQL database and reads dataset rows in pages.
PYTHON_DATABASE_URL=
PYTHON_EXECUTABLE=
PYTHON_DATABASE_QUERY_TIMEOUT=60000
PYTHON_ANALYSIS_TIMEOUT_MS=900000

# Contact discovery reuses the existing Tavily key, only after explicit opt-in.
RESEARCH_PROVIDER_NAME=TAVILY
RESEARCH_API_KEY=
CONTACT_DISCOVERY_PROVIDER=

# S3-compatible private object storage (Cloudflare R2 is the recommended fit).
OBJECT_STORAGE_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
OBJECT_STORAGE_BUCKET=tradeintel-source-files
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_PRESIGN_TTL_SECONDS=900

# Keep one active/completed dataset. A validated replacement is imported before
# a prior completed analysis is eligible for dataset-scoped cleanup.
MAX_ACTIVE_DATASETS=1

# Optional Google OAuth settings for frontend login.
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_AUTH_PROXY=https://your-oauth-proxy.example.com/auth/google/callback

# Outbound email transmission safety gate (must remain false until explicit operational approval).
EMAIL_SENDING_ENABLED=false

# Optional server-side Gmail OAuth 2.0 (Gmail API) settings.
# When EMAIL_PROVIDER=gmail_oauth or GOOGLE_OAUTH_* credentials are set, Gmail API OAuth 2.0 is used
# and the server will never downgrade to an App Password.
EMAIL_PROVIDER=
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/admin
GOOGLE_OAUTH_ALLOWED_REDIRECT_URIS=

# Optional Hostinger SMTP / IMAP settings. Sending requires a separate explicit approval action.
HOSTINGER_SMTP_HOST=smtp.hostinger.com
HOSTINGER_SMTP_PORT=465
HOSTINGER_SMTP_USER=your-mailbox@example.com
HOSTINGER_SMTP_PASS=your-hostinger-app-password
HOSTINGER_IMAP_HOST=imap.hostinger.com
HOSTINGER_IMAP_PORT=993
HOSTINGER_IMAP_USER=your-mailbox@example.com
HOSTINGER_IMAP_PASS=your-hostinger-app-password
HOSTINGER_CONFIG_ENCRYPTION_KEY=

# Reply‑Sender configuration variables (placeholders)
REPLY_SENDER_DATABASE_URL=
REPLY_SEND_OWNER_ROLE=
REPLY_SENDER_ROLE=
REPLY_SEND_APP_ROLE=
REPLY_SENDER_LOGIN_ROLE=
REPLY_SEND_MIGRATION_LOGIN_ROLE=
